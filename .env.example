# NEXT_PUBLIC_* values are compiled into the browser bundle: never put a secret in one.

# --- Required -------------------------------------------------------------

# Public HTTPS origin of this deployment, no trailing slash (e.g. https://your-app.vercel.app).
# Localhost/http is rejected even in dev (shared/siteIdentity.ts) — use your deploy URL locally too.
NEXT_PUBLIC_SITE_URL=

# Sanity project id and dataset, from sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Optional (the site runs without these) -------------------------------

# Pinned Sanity API version; defaults to the value in sanity/env.ts when unset.
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Server-only Viewer (read-only) token; enables Draft Mode preview in /studio (app/api/draft-mode/*).
SANITY_API_READ_TOKEN=

# Only if the Studio previews a site on a different origin; normally blank (Studio is at /studio).
NEXT_PUBLIC_SANITY_PREVIEW_ORIGIN=

# Server-only Billetto API key pair; without it events show no live "spots left" count.
BILLETTO_API_KEY_ID=
BILLETTO_ACCESS_KEY_SECRET=

# --- Local scripts and tests only (never set on Vercel) -------------------

# Server-only Editor token for the `npm run sanity:*` scripts that write to the dataset.
SANITY_API_WRITE_TOKEN=

# The variables below are commented out on purpose: the code falls back to defaults with `??`,
# which ignores undefined but NOT an empty string — uncomment only when you need a real value.

# Fallback read token for scripts/audit-validation.ts when SANITY_API_READ_TOKEN is unset.
# SANITY_AUTH_TOKEN=

# Target for scripts/verify-billetto-live.ts (defaults: http://localhost:3000 and a sample event).
# BILLETTO_VERIFY_SITE=
# BILLETTO_VERIFY_SLUG=
# BILLETTO_VERIFY_EVENT_ID=

# Origin that tests/event-sharing.spec.ts loads pages from; unset = the local Playwright baseURL.
# EVENT_SHARING_TEST_ORIGIN=
