{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint -- *)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit -- *)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git tag *)",
      "Bash(git pull *)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh issue *)",
      "Bash(npm run sanity:*)",
      "Bash(npm run billetto:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-writes.mjs\""
          }
        ]
      }
    ]
  }
}
